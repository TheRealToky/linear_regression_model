# uv cache (if project-local)
.uv/

# ==========================================
# JUPYTER NOTEBOOKS
# ==========================================

.ipynb_checkpoints/
*/.ipynb_checkpoints/
jupyter_cache/

# ==========================================
# DATA SCIENCE DATASETS
# ==========================================

# Raw and processed datasets
# Leading "/" = only at the repo root, so folders like
# FlutterApp/lib/data/ or API/data/ are NOT ignored.
/data/
/datasets/
/raw_data/
/processed_data/
/interim_data/
/external_data/

# Common data formats
*.csv
*.tsv
*.parquet
*.feather
*.arrow
*.h5
*.hdf5
*.pkl
*.pickle
*.joblib
*.npy
*.npz
*.mat
*.sav
*.dta
*.rds

# Compressed datasets
*.zip
*.tar
*.gz
*.bz2
*.7z

# ==========================================
# MACHINE LEARNING MODELS
# ==========================================

# Root-only, so API/models/ (Pydantic schemas) and
# FlutterApp/lib/models/ (Dart classes) are NOT ignored.
/models/
/checkpoints/
/weights/
/artifacts/

*.pt
*.pth
*.ckpt
*.onnx
*.pb
*.keras
*.safetensors
*.model
*.bin

# Keep the trained model the deployed API loads
!summative/API/**/*.pkl
!summative/API/**/*.joblib

