*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
wheels/
.eggs/
pip-wheel-metadata/

# ==========================================
# UV / PYTHON ENVIRONMENTS
# ==========================================

.venv/
venv/
env/
ENV/
